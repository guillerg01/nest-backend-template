{
  "name": "nest-backend-template",
  "version": "1.0.0",
  "description": "Production-ready NestJS backend template — TypeORM, Redis, Stripe, WebSockets, BullMQ, OpenAI, S3, Pino, Sentry",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "m:gen": "typeorm-ts-node-commonjs migration:generate -d src/config/database.config.ts",
    "m:run": "typeorm-ts-node-commonjs migration:run -d src/config/database.config.ts",
    "m:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/database.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/cache-manager": "^3.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/bull-shared": "^11.0.4",

    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-google-oauth20": "^2.0.0",
    "typeorm": "^0.3.22",
    "pg": "^8.14.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",

    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "bcryptjs": "^3.0.2",

    "cache-manager": "^6.4.0",
    "cache-manager-ioredis-yet": "^2.1.0",
    "ioredis": "^5.7.0",
    "bullmq": "^5.0.0",
    "@bull-board/api": "^8.0.0",
    "@bull-board/nestjs": "^8.0.0",
    "@bull-board/express": "^8.0.0",

    "stripe": "^18.0.0",
    "nodemailer": "^6.10.0",
    "cheerio": "^1.0.0",
    "axios": "^1.8.4",
    "helmet": "^8.0.0",
    "nestjs-pino": "^4.0.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "pino-pretty": "^11.0.0",

    "joi": "^17.13.3",
    "nanoid": "^5.1.5",
    "slugify": "^1.6.6",
    "date-fns": "^4.1.0",
    "uuid": "^10.0.0",

    "openai": "^4.80.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",

    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "multer": "1.4.5-lts.1",

    "@sentry/node": "^8.0.0",
    "@sentry/profiling-node": "^8.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^6.4.17",
    "@types/multer": "^1.4.12",
    "@types/uuid": "^10.0.0",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
