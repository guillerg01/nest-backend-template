# Copy this file to .env and fill in your values

# APP
NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0
FRONTEND_URL=http://localhost:3001
LOG_LEVEL=debug

# JWT
JWT_SECRET=supersecretkey_CHANGE_IN_PRODUCTION_min_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=refresh_supersecretkey_CHANGE_IN_PRODUCTION
JWT_REFRESH_EXPIRES_IN=7d

# DATABASE
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nest_template
DB_SYNC=true
DB_MIGRATIONS_RUN=false

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# SECURITY
HASH_SALT=10

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# STRIPE
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# EMAIL SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@example.com

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=my-app-bucket

# OPENAI
OPENAI_API_KEY=sk-...

# SENTRY (leave empty to disable)
SENTRY_DSN=

# BLOCKCHAIN
EVM_RPC_URL=https://eth.llamarpc.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# SCRAPING
SCRAPING_CONCURRENCY=5
SCRAPING_DELAY_MS=2000
